{
  "manifest_version": 3,
  "key": "",
  "name": "HAF Watcher — BlackHatWorld Hire a Freelancer",
  "version": "0.90.0",
  "description": "Watches the Hire a Freelancer forum, scores every new thread, and has Claude write the technical lines of your reply and PM. Nothing posts without your tap.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.blackhatworld.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.anthropic.com/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
